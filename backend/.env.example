PORT=3001
NODE_ENV=development

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
